# Run scripts/init.ps1 (Windows) or sh scripts/init.sh (Linux/macOS).
# Never commit .env. The initializer generates the database password.
COMPOSE_PROJECT_NAME=picpilot-platform
COMPOSE_PARALLEL_LIMIT=1
POSTGRES_PASSWORD=
PICPILOT_PUBLIC_URL=http://localhost:8080
PICPILOT_ADMIN_URL=http://localhost:8081
PICPILOT_BIND_ADDRESS=127.0.0.1
PICPILOT_HTTP_PORT=8080
PICPILOT_ADMIN_PORT=8081
PICPILOT_NETWORK_SUBNET=172.28.56.0/24
PICPILOT_PROXY_ADDRESS=172.28.56.10
PICPILOT_REGISTRATION_ENABLED=false
# auto enables local HTTP/private Provider endpoints when PICPILOT_PUBLIC_URL
# points to localhost/loopback; set false for a strict local installation or a
# public deployment, and true only for a trusted private gateway.
PICPILOT_ALLOW_PRIVATE_PROVIDERS=auto
PICPILOT_DEMO_MODE=false
PICPILOT_WORKER_LEASE_GRACE_SECONDS=15
PICPILOT_WORKER_INPUT_TTL_SECONDS=300
# Asset storage defaults to the private Docker volume. Set backend=object only
# after provisioning a dedicated private bucket and supplying credentials in a
# secret manager or an ignored .env file.
PICPILOT_ASSET_STORAGE_BACKEND=local
PICPILOT_OBJECT_STORAGE_ENDPOINT=
PICPILOT_OBJECT_STORAGE_BUCKET=
PICPILOT_OBJECT_STORAGE_REGION=us-east-1
PICPILOT_OBJECT_STORAGE_PREFIX=picpilot
PICPILOT_OBJECT_STORAGE_ACCESS_KEY=
PICPILOT_OBJECT_STORAGE_SECRET_KEY=
PICPILOT_OBJECT_STORAGE_SESSION_TOKEN=
PICPILOT_OBJECT_STORAGE_ALLOW_INSECURE_HTTP=false
PICPILOT_OBJECT_STORAGE_VIRTUAL_HOST_STYLE=false
PICPILOT_OBJECT_STORAGE_OPERATION_TIMEOUT_SECONDS=30
PICPILOT_OBJECT_STORAGE_UPLOAD_TIMEOUT_SECONDS=900
PICPILOT_OBJECT_STORAGE_READ_TIMEOUT_SECONDS=600
PICPILOT_OBJECT_STORAGE_MAX_CONCURRENT_UPLOADS=2
# The API image contains libvips/libheif. Keep this off for a minimal direct
# Go run; Docker quick-start may set it true after the native probe passes.
PICPILOT_HEIF_ENABLED=true
PICPILOT_HEIF_VIPS_PATH=
PICPILOT_HEIF_VIPSHEADER_PATH=
PICPILOT_HEIF_TEMP_DIR=
PICPILOT_HEIF_TIMEOUT_SECONDS=30
PICPILOT_HEIF_MAX_CONCURRENT=2
# Optional SMTP, OAuth and Turnstile settings are described in docs/configuration.md.
