{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suakitsu.com/schemas/picpilot-local-worker-v1",
  "$defs": {
    "workerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{3,120}$"
    },
    "leaseId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "capability": {
      "enum": [
        "image",
        "text"
      ]
    },
    "protocol": {
      "enum": [
        "openai_responses",
        "openai_chat_completions",
        "openai_images_generations",
        "openai_images_edits"
      ]
    },
    "textModel": {
      "enum": [
        "gpt-5.6-sol",
        "gpt-5.5",
        "gpt-5.6-terra",
        "gpt-5.6-luna"
      ]
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "heartbeatRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workerId",
        "capabilities",
        "maxConcurrency"
      ],
      "properties": {
        "workerId": {
          "$ref": "#/$defs/workerId"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "heartbeatResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workerId",
        "serverTime",
        "activeTasks",
        "heartbeatIntervalSeconds"
      ],
      "properties": {
        "workerId": {
          "$ref": "#/$defs/workerId"
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        },
        "activeTasks": {
          "type": "integer",
          "minimum": 0
        },
        "heartbeatIntervalSeconds": {
          "type": "integer",
          "minimum": 5
        }
      }
    },
    "claimRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workerId",
        "capabilities",
        "maxTasks",
        "waitSeconds"
      ],
      "properties": {
        "workerId": {
          "$ref": "#/$defs/workerId"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "maxTasks": {
          "const": 1
        },
        "waitSeconds": {
          "type": "integer",
          "minimum": 20,
          "maximum": 30
        }
      }
    },
    "responsesPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "input",
        "stream"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/textModel"
        },
        "input": {},
        "instructions": {},
        "temperature": {},
        "top_p": {},
        "max_output_tokens": {},
        "reasoning": {},
        "text": {},
        "tools": {},
        "tool_choice": {},
        "metadata": {},
        "store": {},
        "stream": {
          "const": false
        }
      }
    },
    "chatCompletionsPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "messages",
        "stream"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/textModel"
        },
        "messages": {
          "type": "array",
          "minItems": 1
        },
        "temperature": {},
        "top_p": {},
        "max_tokens": {},
        "max_completion_tokens": {},
        "frequency_penalty": {},
        "presence_penalty": {},
        "response_format": {},
        "stop": {},
        "seed": {},
        "stream": {
          "const": false
        },
        "reasoning_effort": {},
        "thinking": {},
        "tools": {},
        "tool_choice": {}
      }
    },
    "imageGenerationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "prompt",
        "n"
      ],
      "properties": {
        "model": {
          "const": "gpt-image-2"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        },
        "n": {
          "const": 1
        },
        "size": {},
        "quality": {},
        "output_format": {},
        "response_format": {},
        "background": {},
        "moderation": {},
        "output_compression": {},
        "user": {}
      }
    },
    "imageEditPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "prompt",
        "n"
      ],
      "properties": {
        "model": {
          "const": "gpt-image-2"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        },
        "n": {
          "const": 1
        },
        "size": {},
        "quality": {},
        "output_format": {},
        "response_format": {},
        "background": {},
        "moderation": {},
        "output_compression": {},
        "input_fidelity": {},
        "user": {}
      }
    },
    "inputFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "url",
        "filename",
        "contentType",
        "fileSize",
        "urlExpiresAt",
        "urlChecksum",
        "urlSignatureAlgorithm"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "filename": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "fileSize": {
          "type": "integer",
          "minimum": 0
        },
        "urlExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "urlChecksum": {
          "$ref": "#/$defs/sha256"
        },
        "urlSignatureAlgorithm": {
          "const": "HMAC-SHA256"
        }
      }
    },
    "claimedTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "leaseId",
        "leaseUntil",
        "renewAfter",
        "graceUntil",
        "capability",
        "protocol",
        "model",
        "request",
        "inputFiles",
        "attempt"
      ],
      "properties": {
        "jobId": {
          "type": "string"
        },
        "leaseId": {
          "$ref": "#/$defs/leaseId"
        },
        "leaseUntil": {
          "type": "string",
          "format": "date-time"
        },
        "renewAfter": {
          "type": "string",
          "format": "date-time"
        },
        "graceUntil": {
          "type": "string",
          "format": "date-time"
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "model": {
          "enum": [
            "gpt-image-2",
            "gpt-5.6-sol",
            "gpt-5.5",
            "gpt-5.6-terra",
            "gpt-5.6-luna"
          ]
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/responsesPayload"
            },
            {
              "$ref": "#/$defs/chatCompletionsPayload"
            },
            {
              "$ref": "#/$defs/imageGenerationPayload"
            },
            {
              "$ref": "#/$defs/imageEditPayload"
            }
          ]
        },
        "inputFiles": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/inputFile"
          }
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "claimResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "empty",
        "serverTime",
        "waitedMs"
      ],
      "properties": {
        "task": {
          "oneOf": [
            {
              "$ref": "#/$defs/claimedTask"
            },
            {
              "type": "null"
            }
          ]
        },
        "empty": {
          "type": "boolean"
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        },
        "waitedMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "leaseRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workerId",
        "leaseId"
      ],
      "properties": {
        "workerId": {
          "$ref": "#/$defs/workerId"
        },
        "leaseId": {
          "$ref": "#/$defs/leaseId"
        }
      }
    },
    "leaseResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "leaseUntil",
        "renewAfter",
        "graceUntil"
      ],
      "properties": {
        "jobId": {
          "type": "string"
        },
        "leaseUntil": {
          "type": "string",
          "format": "date-time"
        },
        "renewAfter": {
          "type": "string",
          "format": "date-time"
        },
        "graceUntil": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifactForm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workerId",
        "leaseId",
        "idempotencyKey",
        "sha256",
        "file"
      ],
      "properties": {
        "workerId": {
          "$ref": "#/$defs/workerId"
        },
        "leaseId": {
          "$ref": "#/$defs/leaseId"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/idempotencyKey"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file": {
          "type": "string",
          "contentEncoding": "binary",
          "contentMediaType": "image/png"
        }
      }
    },
    "artifactResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "idempotent",
        "contentType",
        "fileSize",
        "sha256",
        "sourceSha256",
        "width",
        "height",
        "format"
      ],
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "idempotent": {
          "type": "boolean"
        },
        "contentType": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        },
        "fileSize": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "enum": [
            "jpeg",
            "png",
            "webp"
          ]
        }
      }
    },
    "completeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workerId",
        "leaseId",
        "idempotencyKey"
      ],
      "properties": {
        "workerId": {
          "$ref": "#/$defs/workerId"
        },
        "leaseId": {
          "$ref": "#/$defs/leaseId"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/idempotencyKey"
        },
        "artifactId": {
          "type": "string"
        },
        "result": {},
        "metadata": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "required": [
            "artifactId"
          ]
        },
        {
          "required": [
            "result"
          ]
        }
      ]
    },
    "terminalResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "status",
        "idempotent"
      ],
      "properties": {
        "jobId": {
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "idempotent": {
          "type": "boolean"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "failRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workerId",
        "leaseId",
        "idempotencyKey",
        "errorCode",
        "errorMessage"
      ],
      "properties": {
        "workerId": {
          "$ref": "#/$defs/workerId"
        },
        "leaseId": {
          "$ref": "#/$defs/leaseId"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/idempotencyKey"
        },
        "errorCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "errorMessage": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
